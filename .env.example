# ---------------------------------------------------
# NexusGuard environment configuration (example file)
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file.
# ---------------------------------------------------

# --- Application ---
APP_NAME=NexusGuard
APP_ENV=development
APP_DEBUG=true

# --- MongoDB (added in Phase 2) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nexusguard

# --- RabbitMQ (added in Phase 3) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

RABBITMQ_EXCHANGE=transaction_exchange
RABBITMQ_QUEUE=transaction_queue
RABBITMQ_ROUTING_KEY=transaction.new

# --- RabbitMQ Dead Letter Queue (added in Phase 4) ---
RABBITMQ_DLX=transaction_dlx
RABBITMQ_DLQ=transaction_dlq
RABBITMQ_DLQ_ROUTING_KEY=transaction.failed

# --- Fraud Detection Engine (added in Phase 5) ---
# Transaction value above this adds risk points (RULE 1).
FRAUD_HIGH_VALUE_THRESHOLD=50000
# Transaction value above this adds ADDITIONAL risk points (RULE 2).
FRAUD_VERY_HIGH_VALUE_THRESHOLD=150000
# Quantity above this adds risk points (RULE 3).
FRAUD_HIGH_QUANTITY_THRESHOLD=5
# Comma-separated symbols to flag as suspicious (RULE 5). Empty by
# default — e.g. FRAUD_SUSPICIOUS_SYMBOLS=SCAMCOIN,RUGPULL
FRAUD_SUSPICIOUS_SYMBOLS=

# --- Behavioral & Historical Fraud Detection (added in Phase 6) ---
BEHAVIOR_HISTORY_LOOKBACK=100
BEHAVIOR_VELOCITY_WINDOW_SECONDS=60
BEHAVIOR_VELOCITY_MAX_TRANSACTIONS=5
BEHAVIOR_FREQUENCY_WINDOW_MINUTES=60
BEHAVIOR_FREQUENCY_BASELINE_WINDOW_MINUTES=1440
BEHAVIOR_FREQUENCY_MULTIPLIER=3.0
BEHAVIOR_VALUE_DEVIATION_MULTIPLIER=3.0
BEHAVIOR_VALUE_UNUSUAL_MULTIPLIER=8.0
BEHAVIOR_MIN_HISTORY_FOR_SYMBOL_CHECK=3

# --- Combined Risk Weighting (added in Phase 6) ---
# Must sum to 1.0
FRAUD_INDIVIDUAL_WEIGHT=0.6
FRAUD_BEHAVIORAL_WEIGHT=0.4

# --- Kafka ingestion bridge ---
# Set true only when a Kafka broker is reachable.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTION_TOPIC=nexusguard.transactions
KAFKA_INVALID_TOPIC=nexusguard.transactions.invalid
KAFKA_PROCESSED_TOPIC=nexusguard.transactions.processed
KAFKA_GROUP_ID=nexusguard-transaction-consumer
KAFKA_CLIENT_ID=nexusguard-api
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Optional SASL settings for secured brokers.
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# --- Apache NiFi ---
NIFI_ENABLED=false
NIFI_URL=https://localhost:8443/nifi
NIFI_USERNAME=admin
# Required by docker-compose.yml; choose a local development password.
NIFI_PASSWORD=replace-with-a-local-password
